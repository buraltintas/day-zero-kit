# Yalnız adlar. Değer bu dosyaya ve hiçbir dosyaya yazılmaz.
# Yer: KARAR BEKLİYOR (K-009); rehberin önerisi Secret Manager.
# Adlar ilk kodla kesinleşir; kodun okuduğu her ad burada olur.
# Yerel varsayılan test ortamıdır; prod değeri yerelde bulunmaz.

# Ortam: test | prod (yerelde her zaman test)
APP_ENV=

# API: Neon, üç rol (K-005)
# uygulama rolü, yalnız DML, -pooler adresi
DATABASE_URL=
# migration rolü, şema sahibi, direct adres
MIGRATE_DATABASE_URL=
# yedek rolü, salt okunur, direct adres
BACKUP_DATABASE_URL=

# Adresler
SITE_URL=
API_URL=

# Web kapısı: Worker'dan gelen gizli başlık
EDGE_KEY=

# E-posta (K-015): Resend AB, yedek Amazon SES eu-west-1
RESEND_API_KEY=
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

# Kod formu: Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admin izin listesi (K-024)
ADMIN_EMAIL_ALLOWLIST=
# Test ortamında giriş izin listesi (K-010 bekliyor)
TEST_LOGIN_ALLOWLIST=

# Mobil: preview ve yerel build test API'sine bakar
EXPO_PUBLIC_API_URL=
